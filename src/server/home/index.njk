{% extends 'layouts/page.njk' %}

{% set mainClasses = "app-main-wrapper app-main-wrapper--hero" %}

{% block content %}

  <div class="defra-hero">
    <div class="govuk-width-container">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <h1 class="govuk-heading-xl govuk-!-margin-top-4">AI Capabilities &amp; Enablement</h1>
          <p class="govuk-body-l">
            Supporting Defra teams to use AI safely and effectively. Find guidance, patterns, tools
            and the latest developments from across the department.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="govuk-width-container">

    <section class="defra-section" aria-label="Explore">
      <ul class="defra-tile-grid">
        {% for card in cards %}
          <li>
            <div class="defra-tile">
              <h3 class="govuk-heading-m defra-tile__title">
                <a class="defra-tile__link" href="{{ card.href }}">{{ card.title }}</a>
              </h3>
              <p class="govuk-body defra-tile__body">{{ card.description }}</p>
            </div>
          </li>
        {% endfor %}
      </ul>
    </section>

    {% if whatWeDo.length > 0 %}
      <section class="defra-section" aria-labelledby="what-we-do-heading">
        <h2 class="govuk-heading-l" id="what-we-do-heading">What we do</h2>
        <div class="govuk-grid-row">
          {% for item in whatWeDo %}
            <div class="govuk-grid-column-one-quarter govuk-!-margin-top-4">
              {% if item.image %}
                <img src="{{ item.image }}" alt="{{ item.imageAlt }}" loading="lazy" class="govuk-!-width-full">
              {% endif %}
              <h3 class="govuk-heading-m govuk-!-margin-top-3">{{ item.title }}</h3>
              <p class="govuk-body">{{ item.description }}</p>
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

  </div>

{% endblock %}
